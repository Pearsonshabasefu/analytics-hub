# Backend environment variables
# Copy this file to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini AI
GEMINI_API_KEY=your-google-ai-studio-api-key

# Modal (Serverless GPU)
MODAL_TOKEN_ID=your-modal-token-id
MODAL_TOKEN_SECRET=your-modal-token-secret

# Resend (Email alerts)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=alerts@analyticshub.ai

# Flutterwave (Billing — OCU top-ups)
# Get keys from: https://dashboard.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-secret-key-here
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-here

# App settings
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-secret
CORS_ORIGINS=["http://localhost:5173","https://your-vercel-domain.vercel.app"]
